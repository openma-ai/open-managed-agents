{
  "name": "@openma/cli",
  "version": "0.8.1",
  "description": "CLI for the openma managed agents platform",
  "type": "module",
  "bin": {
    "oma": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@boxlite-ai/boxlite --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\nimport { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "managed-agents",
    "openma",
    "cli",
    "llm",
    "claude-managed-agents",
    "openai-agents",
    "self-hosted",
    "sandbox",
    "agent-runtime"
  ],
  "license": "Apache-2.0",
  "homepage": "https://openma.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/openma-ai/open-managed-agents",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/openma-ai/open-managed-agents/issues"
  },
  "devDependencies": {
    "@inquirer/checkbox": "^5.2.1",
    "@open-managed-agents/acp-runtime": "workspace:*",
    "@open-managed-agents/api-types": "workspace:*",
    "@open-managed-agents/runtime": "workspace:*",
    "@openma/common": "^0.9.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.18.0",
    "fflate": "^0.8.2",
    "@open-managed-agents/sandbox": "workspace:*",
    "@open-managed-agents/managed-runtime-boxlite": "workspace:*"
  },
  "peerDependencies": {
    "@boxlite-ai/boxlite": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "@boxlite-ai/boxlite": {
      "optional": true
    }
  }
}
