{
  "name": "@openma/stores-sql",
  "version": "0.0.0",
  "description": "SQL OpenMA store adapters for every @openma/core storage Port, over a driver-neutral SqlClient (SQLite, Postgres, MySQL).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/build-public-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "node ../../scripts/build-public-package.mjs --assert-pnpm-publish"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "keywords": [
    "openma",
    "managed-agents",
    "agents",
    "store",
    "sql",
    "sqlite",
    "postgres",
    "mysql"
  ],
  "license": "Apache-2.0",
  "homepage": "https://openma.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/openma-ai/open-managed-agents",
    "directory": "packages/stores-sql"
  },
  "bugs": {
    "url": "https://github.com/openma-ai/open-managed-agents/issues"
  },
  "dependencies": {
    "@openma/core": "workspace:^",
    "effect": "3.22.1"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.3",
    "mysql2": "^3.24.6",
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@open-managed-agents/agent-store-sql": "workspace:*",
    "@open-managed-agents/credential-store-sql": "workspace:*",
    "@open-managed-agents/deployment-run-store-sql": "workspace:*",
    "@open-managed-agents/deployment-store-sql": "workspace:*",
    "@open-managed-agents/dream-store-sql": "workspace:*",
    "@open-managed-agents/environment-store-sql": "workspace:*",
    "@open-managed-agents/environment-work-store-sql": "workspace:*",
    "@open-managed-agents/file-store-sql": "workspace:*",
    "@open-managed-agents/memory-document-store-sql": "workspace:*",
    "@open-managed-agents/memory-store-store-sql": "workspace:*",
    "@open-managed-agents/session-event-store-sql": "workspace:*",
    "@open-managed-agents/session-resource-store-sql": "workspace:*",
    "@open-managed-agents/session-store-sql": "workspace:*",
    "@open-managed-agents/session-thread-store-sql": "workspace:*",
    "@open-managed-agents/skill-store-sql": "workspace:*",
    "@open-managed-agents/sql-client": "workspace:*",
    "@open-managed-agents/tunnel-store-sql": "workspace:*",
    "@open-managed-agents/user-profile-store-sql": "workspace:*",
    "@open-managed-agents/vault-store-sql": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.3"
  }
}
