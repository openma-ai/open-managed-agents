---
import Base from "../layouts/Base.astro";
import FaqSection from "./FaqSection.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import {
  blogPostSchema,
  breadcrumbSchema,
  readingTimeMinutes,
} from "../lib/seo";
import { HREFLANG, UI, blogBase, postPath, postSlug } from "../lib/blog-i18n";

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content } = await render(post);
const lang = post.data.lang;
const t = UI[lang];
const base = blogBase(lang);
const path = postPath(post);
const slug = postSlug(post);

function formatDate(d: Date) {
  return d.toLocaleDateString(t.locale, { year: "numeric", month: "long", day: "numeric" });
}

const ogImage = `https://openma.ai/og${path.replace(/\/$/, "")}.png`.replace("/og/zh/blog/", "/og/blog/zh/");
const minutes = readingTimeMinutes(post.body ?? "");

const published = await getCollection("blog", ({ data }) => !data.draft);
// Translations: same slug, other language.
const translations = published.filter((p) => p.id !== post.id && postSlug(p) === slug);
const alternates = [post, ...translations].map((p) => ({ hreflang: HREFLANG[p.data.lang], path: postPath(p) }));

// Pick 3 related posts (same language) by tag overlap, falling back to recency.
const allPosts = published.filter((p) => p.id !== post.id && p.data.lang === lang);
const related = allPosts
  .map((p) => {
    const overlap = p.data.tags.filter((t) => post.data.tags.includes(t)).length;
    return { post: p, overlap };
  })
  .sort((a, b) => {
    if (b.overlap !== a.overlap) return b.overlap - a.overlap;
    return b.post.data.publishedAt.valueOf() - a.post.data.publishedAt.valueOf();
  })
  .slice(0, 3)
  .map((r) => r.post);

const schemas = [
  blogPostSchema({
    title: post.data.title,
    description: post.data.description,
    slug,
    path,
    inLanguage: HREFLANG[lang],
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
    author: post.data.author,
    tags: post.data.tags,
    image: ogImage,
  }),
  breadcrumbSchema([
    { name: t.home, path: "/" },
    { name: t.blog, path: base },
    { name: post.data.title, path },
  ]),
];
---

<Base
  title={post.data.title}
  description={post.data.description}
  canonical={path}
  lang={HREFLANG[lang]}
  alternates={alternates}
  ogType="article"
  ogImage={ogImage}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  schemas={schemas}
  keywords={post.data.tags.join(", ")}
>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <!-- Breadcrumb (visible — supports the JSON-LD above) -->
    <nav aria-label="Breadcrumb" class="text-xs text-[var(--color-fg-subtle)] mb-6">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">{t.home}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={base} class="hover:underline">{t.blog}</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-[var(--color-fg-muted)] truncate max-w-[12em]" aria-current="page" title={post.data.title}>
          {post.data.title}
        </li>
      </ol>
    </nav>

    <header class="mb-10">
      <div class="text-xs text-[var(--color-fg-subtle)] uppercase tracking-wider mb-2">
        <time datetime={post.data.publishedAt.toISOString()}>
          {formatDate(post.data.publishedAt)}
        </time>
        {post.data.author && <> · {post.data.author}</>}
        <span class="ml-2">· {minutes} {t.read}</span>
        {post.data.updatedAt && (
          <span class="ml-2">
            ({t.updated} <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time>)
          </span>
        )}
      </div>
      {translations.map((tr) => (
        <p class="mb-3 text-sm">
          <a href={postPath(tr)} hreflang={HREFLANG[tr.data.lang]} lang={HREFLANG[tr.data.lang]} class="underline">{UI[tr.data.lang].switchTo}</a>
        </p>
      ))}
      <h1 class="font-display text-4xl font-bold tracking-tight mb-3">{post.data.title}</h1>
      <p class="text-lg text-[var(--color-fg-muted)]">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="mt-4 flex gap-2 flex-wrap" aria-label="Tags">
          {post.data.tags.map((t) => (
            <span class="inline-block px-2 py-0.5 text-xs rounded bg-[var(--color-bg-surface)] text-[var(--color-fg-muted)]">
              {t}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {/* Frontmatter `faq` renders here and emits matching FAQPage JSON-LD. */}
    {post.data.faq?.length ? <FaqSection items={post.data.faq} variant="prose" /> : null}

    {related.length > 0 && (
      <aside class="mt-16 pt-8 border-t border-[var(--color-border)]" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-display text-xl font-semibold mb-5">{t.related}</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {related.map((r) => (
            <a
              href={postPath(r)}
              class="block border border-[var(--color-border)] rounded-lg p-4 hover:border-[var(--color-brand)] transition-colors no-underline"
            >
              <div class="text-xs text-[var(--color-fg-subtle)] mb-1">
                {formatDate(r.data.publishedAt)}
              </div>
              <div class="font-semibold text-sm mb-1 text-[var(--color-fg)]">
                {r.data.title}
              </div>
              <p class="text-xs text-[var(--color-fg-muted)] line-clamp-3">
                {r.data.description}
              </p>
            </a>
          ))}
        </div>
      </aside>
    )}

    <footer class="mt-12 pt-6 border-t border-[var(--color-border)] text-sm text-[var(--color-fg-muted)] flex flex-wrap gap-x-6 gap-y-2 justify-between">
      <a href={base} class="hover:underline">{t.all}</a>
      <a href="/blog/rss.xml" class="hover:underline">{t.rss}</a>
    </footer>
  </article>
</Base>
