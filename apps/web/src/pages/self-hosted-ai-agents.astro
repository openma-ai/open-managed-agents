---
import Base from "../layouts/Base.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import FaqSection from "../components/FaqSection.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import { articleSchema, breadcrumbSchema, faqPageSchema } from "../lib/seo";

const hostingRows = [
  ["Who runs the agent loop", "The vendor", "The vendor", "You"],
  ["Where session history lives", "Vendor cloud", "Vendor cloud", "Your database"],
  ["Where tools execute", "Vendor sandbox or self-hosted sandbox", "Hosted or self-hosted sandbox", "Sandbox provider you choose"],
  ["Models", "Claude", "OpenAI", "Any provider or gateway you configure"],
  ["Credentials", "Stored with the vendor", "Stored with the vendor", "Your vault and secret store"],
  ["Operations", "None for you", "None for you", "Your team"],
];

const deploySteps = [
  "Pick a target: Node.js or Docker on your servers, Fly.io, Vercel (beta), or Cloudflare.",
  "Choose storage: SQLite for one host, PostgreSQL or MySQL for replicas, or Cloudflare D1 / Durable Objects. Use S3-compatible storage or R2 for blobs.",
  "Choose a sandbox driver: Docker, BoxLite, E2B, Daytona, Modal, Sprites, Cloudflare, and others.",
  "Add model credentials as Model Cards: Anthropic, OpenAI, DeepSeek, OpenRouter, or a custom endpoint.",
  "Create an agent and a session through the Console, CLI, or API, and point your SDK at your deployment.",
];

const faqItems = [
  {
    question: "What is a self-hosted AI agent?",
    answer:
      "An AI agent whose runtime (the agent loop, session history, tool execution, and credentials) runs on infrastructure you control. The model can still be a hosted API you call with your own key.",
  },
  {
    question: "Do I need to self-host the model too?",
    answer:
      "No. You can call hosted model APIs with your own keys, or point the runtime at a private gateway or an open-weight model server if your policy requires it.",
  },
  {
    question: "Can I self-host Claude Managed Agents?",
    answer:
      "Not the control plane. Claude Managed Agents supports self-hosted sandboxes, but the harness and sessions run on Anthropic. An open runtime such as OpenMA keeps the same API shape and runs entirely on your infrastructure.",
  },
  {
    question: "What does it take to run OpenMA myself?",
    answer:
      "For a single host, Docker Compose with SQLite. For production, a Node deployment with PostgreSQL or MySQL, object storage, and a sandbox provider, or the Cloudflare setup wizard. The self-host docs cover each path.",
  },
];

const relatedLinks = [
  { href: "/claude-managed-agents-alternative/", anchor: "Claude Managed Agents alternative", note: "Compare hosted CMA with open, self-hosted runtimes." },
  { href: "/open-source-ai-agents/", anchor: "Open-source AI agents", note: "Agent platforms vs frameworks vs coding agents." },
  { href: "/open-source-managed-agents/", anchor: "Open-source managed agents", note: "Shortlist of open runtimes with the managed-agent shape." },
  { href: "/ai-agent-platform/", anchor: "AI agent platform & orchestration", note: "Sessions, sandboxes, model routing, and durability." },
  { href: "/blog/self-host-agent-platform-cloudflare-workers/", anchor: "How to self-host an agent platform on Cloudflare", note: "End-to-end Workers, Durable Objects, and R2 guide." },
];

const schemas = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Self-Hosted AI Agents", path: "/self-hosted-ai-agents/" },
  ]),
  articleSchema({
    headline: "Self-Hosted AI Agents: Run Agents on Your Infra",
    description:
      "Why teams self-host AI agents for control, data residency, and model choice, and how an open managed runtime fits on your own infrastructure.",
    url: "https://openma.ai/self-hosted-ai-agents/",
    datePublished: "2026-11-03",
    dateModified: "2026-11-03",
  }),
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to self-host AI agents with an open managed runtime",
    description: "A high-level path for running AI agents on your own infrastructure with OpenMA.",
    step: deploySteps.map((text, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      text,
    })),
  },
  faqPageSchema(faqItems),
];
---

<Base
  title="Self-Hosted AI Agents (Open-Source Runtime) | OpenMA"
  description="Why teams self-host AI agents for control, data residency, and model choice, plus how OpenMA runs as an open managed runtime on your own infrastructure."
  canonical="/self-hosted-ai-agents/"
  keywords="self-hosted ai agent, self hosted ai agents, self hosted agents, self-hosted agent runtime, best open source ai agents, self hosted claude managed agents"
  schemas={schemas}
>
  <section class="border-b border-[var(--color-border)]">
    <div class="site-container py-16 md:py-24">
      <p class="text-sm font-mono uppercase tracking-wider text-[var(--color-fg-subtle)] mb-4">
        Self-hosted AI agents
      </p>
      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 items-start">
        <div>
          <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight mb-6">
            Self-Hosted AI Agents: Run Agents on Your Infra
          </h1>
          <p class="text-lg text-[var(--color-fg-muted)] leading-relaxed">
            Self-hosting an AI agent means running the part that matters for
            control: the agent loop, session history, tool sandbox, and
            credentials, on infrastructure you own, while still calling
            whichever model API you choose. An open managed runtime such as
            OpenMA provides those pieces as one deployable service.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="https://docs.openma.ai/self-host/overview/" class="site-button site-button-primary">Self-host docs</a>
            <a href="/deploy/" class="site-button">Deployment configurator</a>
          </div>
        </div>
        <div class="border border-[var(--color-border)] rounded-lg bg-[var(--color-bg-surface)] p-5">
          <h2 class="font-display text-xl font-semibold mb-4">What you keep</h2>
          <ul class="space-y-3 text-sm text-[var(--color-fg-muted)]">
            <li><strong class="text-[var(--color-fg)]">Data:</strong> conversation history, tool output, and files stay in your database and storage.</li>
            <li><strong class="text-[var(--color-fg)]">Keys:</strong> model and integration credentials stay in your vaults.</li>
            <li><strong class="text-[var(--color-fg)]">Choice:</strong> swap models, sandboxes, and harnesses without changing your client.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="site-container py-16" data-reveal>
    <h2 class="font-display text-3xl font-bold mb-4">Self-host vs vendor-managed</h2>
    <p class="text-[var(--color-fg-muted)] leading-relaxed mb-8 max-w-3xl">
      The table compares the two vendor-managed agent runtimes with a
      self-hosted one on who runs each part and where data lives.
    </p>
    <ComparisonTable
      columns={["", "Claude Managed Agents", "OpenAI Agents API (managed harness)", "Self-hosted runtime"]}
      rows={hostingRows}
      caption="Self-hosted vs vendor-managed agent runtimes"
    />
    <div class="grid md:grid-cols-2 gap-8 mt-10 max-w-5xl">
      <div>
        <h3 class="font-semibold text-xl mb-2">Claude Managed Agents</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          Anthropic hosts the harness and sessions. Self-hosted sandboxes move
          only tool execution to your infrastructure. Read <a href="/what-is-claude-managed-agents/">what Claude Managed Agents is</a>,
          or compare <a href="/claude-managed-agents-alternative/">Claude Managed Agents alternatives</a>.
        </p>
      </div>
      <div>
        <h3 class="font-semibold text-xl mb-2">OpenAI Agents API (managed harness)</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          OpenAI runs the Codex-based harness, session state, and API. A
          self-hosted sandbox moves code execution to your infrastructure.
          See the <a href="/blog/openai-agents-api-vs-openma/">OpenAI Agents API comparison</a>.
        </p>
      </div>
    </div>
  </section>

    <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-surface)]" data-reveal>
    <div class="site-container py-16">
      <p class="text-[var(--color-fg-muted)] leading-relaxed max-w-3xl">
        This page is about self-hosting a managed agent runtime. Coding agents
        and agent frameworks can also be self-hosted, and the
        <a href="/ai-agent-platform/">AI agent platform &amp; orchestration</a> guide
        explains how those categories differ.
      </p>
    </div>
  </section>

  <section class="site-container py-16" data-reveal>
    <h2 class="font-display text-3xl font-bold mb-8">Why teams self-host</h2>
    <div class="space-y-8 max-w-4xl">
      <div class="grid md:grid-cols-[0.8fr_1.2fr] gap-4 md:gap-8 border-t border-[var(--color-border)] pt-6">
        <h3 class="font-semibold text-lg">Security and data residency</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          Agents see sensitive context: tickets, code, customer records, tool
          output. Self-hosting keeps that history and the sandbox inside your
          network, region, and audit tooling.
        </p>
      </div>
      <div class="grid md:grid-cols-[0.8fr_1.2fr] gap-4 md:gap-8 border-t border-[var(--color-border)] pt-6">
        <h3 class="font-semibold text-lg">BYOK and model choice</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          Bring your own keys and pay providers directly. Route agents to
          different models by task, keep a fallback vendor, or use a private
          gateway, without changing the runtime.
        </p>
      </div>
      <div class="grid md:grid-cols-[0.8fr_1.2fr] gap-4 md:gap-8 border-t border-[var(--color-border)] pt-6">
        <h3 class="font-semibold text-lg">Control of the loop</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          With an open runtime you can read the harness, change context
          engineering, and pick the sandbox. The trade-off is that you also
          own upgrades and on-call.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-surface)]" data-reveal>
    <div class="site-container py-16">
      <h2 class="font-display text-3xl font-bold mb-4">Deploying OpenMA</h2>
      
      <ol class="space-y-3 text-[var(--color-fg-muted)] leading-relaxed list-decimal pl-5 max-w-3xl">
        {deploySteps.map((step) => <li>{step}</li>)}
      </ol>
      <p class="text-[var(--color-fg-muted)] leading-relaxed mt-6 max-w-3xl">
        The quickest local start is Docker Compose:
      </p>
      <pre class="mt-3 max-w-3xl overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-4 text-sm font-mono"><code>git clone https://github.com/openma-ai/open-managed-agents
cd open-managed-agents
cp .env.example .env   # add a model provider key
docker compose up -d</code></pre>
      <p class="text-[var(--color-fg-muted)] leading-relaxed mt-6 max-w-3xl">
        For production, follow the <a href="https://docs.openma.ai/self-host/node-docker/">Node + Docker guide</a>,
        or read <a href="/blog/self-host-agent-platform-cloudflare-workers/">how to self-host an agent platform on Cloudflare Workers</a>.
        Node deployments scale out across replicas with shared PostgreSQL or MySQL.
      </p>
    </div>
  </section>

  <section class="site-container py-16" data-reveal>
    <h2 class="font-display text-3xl font-bold mb-4">Where OpenMA fits</h2>
    <h3 class="font-semibold text-xl mb-4">Coding agents inside the runtime</h3>
    <div class="max-w-3xl space-y-4 text-[var(--color-fg-muted)] leading-relaxed">
      <p>
        OpenMA is an open-source managed agent runtime. It provides the same
        building blocks as vendor-managed services (agents, environments,
        sessions, events, vaults, memory stores) with a Claude Managed
        Agents-compatible API at <code>/v1</code> and an OpenAI Agents API
        adapter at <code>/openai/v1</code>.
      </p>
      <p>
        Your applications, integrations, and teams call it to run agents of
        any kind. Coding agents such as Claude Code and Codex can run inside
        it through ACP adapters. For the category view, see
        <a href="/ai-agent-platform/">AI agent platform &amp; orchestration</a>.
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="https://docs.openma.ai/self-host/overview/" class="site-button site-button-primary">Deploy an open managed runtime on your infra</a>
      <a href="/claude-managed-agents-alternative/" class="site-button">Compare with Claude Managed Agents</a>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-surface)]" data-reveal>
    <div class="site-container py-16 max-w-4xl">
      <h2 class="font-display text-3xl font-bold mb-4">Related open-source paths</h2>
      <p class="text-[var(--color-fg-muted)] leading-relaxed">
        Compare <a href="/open-source-ai-agents/">open-source AI agents</a> by
        category, or go straight to the
        <a href="/open-source-managed-agents/">open-source managed agents</a> shortlist.
      </p>
    </div>
  </section>

  <FaqSection items={faqItems} />
  <RelatedGuides links={relatedLinks} />
</Base>
