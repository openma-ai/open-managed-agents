---
import Base from "../layouts/Base.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import FaqSection from "../components/FaqSection.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import { breadcrumbSchema, faqPageSchema } from "../lib/seo";

const DOCS = "https://platform.claude.com/docs/en/managed-agents";

const buildingBlocks = [
  {
    name: "Agent",
    href: `${DOCS}/agent-setup`,
    body: "A versioned configuration: the Claude model, system prompt, tools, MCP servers, skills, and any agents it may delegate to. Agents hold no conversation state.",
  },
  {
    name: "Environment",
    href: `${DOCS}/environments`,
    body: "The sandbox specification — packages, networking rules, and whether tools run in Anthropic's cloud sandbox or a self-hosted sandbox you operate.",
  },
  {
    name: "Session",
    href: `${DOCS}/sessions`,
    body: "One running conversation between your application and an agent in an environment. Sessions are long-running: they can work for a long time, go idle, and be resumed later.",
  },
  {
    name: "Events",
    href: `${DOCS}/events-and-streaming`,
    body: "The append-only stream of what happened: user messages, agent messages, tool use and results, and status changes such as running and idle. You stream it over SSE.",
  },
];

const sdkRows = [
  ["Where the harness runs", "Anthropic's infrastructure", "Your process"],
  ["Session state", "Hosted, durable, resumable", "Yours to persist"],
  ["Sandbox", "Anthropic cloud sandbox or self-hosted sandbox", "Wherever your process runs, unless you add one"],
  ["Scaling and recovery", "Handled by Anthropic", "Yours to build"],
  ["Billing", "Tokens + session runtime", "Tokens + your own compute"],
  ["Models", "Claude", "Claude"],
];

const faqItems = [
  {
    question: "What is Claude Managed Agents in simple terms?",
    answer:
      "It is Anthropic's hosted service for running AI agents. You describe the agent and its sandbox; Anthropic runs the agent loop, executes tools in a sandbox, keeps the session state, and streams results back to your application.",
  },
  {
    question: "Are Claude Managed Agents and Anthropic Managed Agents the same thing?",
    answer:
      "Yes. Anthropic markets the product as Claude Managed Agents; people also search for it as Anthropic Managed Agents.",
  },
  {
    question: "Is Claude Managed Agents the same as Claude Code?",
    answer:
      "No. Claude Code is a coding agent a developer uses directly. Claude Managed Agents is an API platform your application calls to run agents of any kind, billed by usage rather than by seat.",
  },
  {
    question: "How much does Claude Managed Agents cost?",
    answer:
      "Standard token rates for the Claude model plus a session-runtime fee while a session is running. See the Claude Managed Agents pricing breakdown for a worked example.",
  },
  {
    question: "Can I use models other than Claude?",
    answer:
      "No. Claude Managed Agents runs Claude models. If you need several model vendors behind the same agents-and-sessions API, look at open, model-agnostic managed runtimes.",
  },
];

const relatedLinks = [
  { href: "/claude-managed-agents-alternative/", anchor: "Claude Managed Agents alternative", note: "Open-source and self-hosted options compared." },
  { href: "/blog/claude-managed-agents-pricing/", anchor: "Claude Managed Agents pricing", note: "Session runtime, tokens, and a worked monthly example." },
  { href: "/blog/claude-agent-sdk-vs-managed-agents/", anchor: "Claude Agent SDK vs managed agents", note: "In-process harness vs hosted runtime, and when to migrate." },
  { href: "/blog/claude-managed-agents-vs-open-managed-agents/", anchor: "Claude Managed Agents vs OpenMA", note: "Side-by-side feature matrix." },
];

const schemas = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "What Is Claude Managed Agents?", path: "/what-is-claude-managed-agents/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "What Is Claude Managed Agents?",
    url: "https://openma.ai/what-is-claude-managed-agents/",
    description:
      "A plain-English overview of Claude Managed Agents: building blocks, how it differs from the Claude Agent SDK, limits, and when to consider open alternatives.",
    about: [
      { "@type": "Thing", name: "Claude Managed Agents" },
      { "@type": "Thing", name: "Anthropic Managed Agents" },
      { "@type": "Thing", name: "Agent harness" },
    ],
  },
  faqPageSchema(faqItems),
];
---

<Base
  title="What Is Claude Managed Agents? Overview | OpenMA"
  description="Plain-English overview of Anthropic's managed agent runtime — vs Agent SDK, limits, and when to consider open alternatives."
  canonical="/what-is-claude-managed-agents/"
  keywords="what is claude managed agents, what are claude managed agents, claude managed agents, claude managed agents overview, anthropic managed agents"
  schemas={schemas}
>
  <section class="border-b border-[var(--color-border)]">
    <div class="site-container py-16 md:py-24 max-w-4xl">
      <p class="text-sm font-mono uppercase tracking-wider text-[var(--color-fg-subtle)] mb-4">
        Claude Managed Agents overview
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight mb-6">
        What Is Claude Managed Agents?
      </h1>
      <p class="text-lg text-[var(--color-fg-muted)] leading-relaxed">
        A plain-English guide to Anthropic's hosted agent runtime: what it
        does, the four building blocks you work with, how it differs from the
        Claude Agent SDK, and the trade-offs to weigh before you build on it.
      </p>
    </div>
  </section>

  <section class="site-container py-16" data-reveal>
    <h2 class="font-display text-3xl font-bold mb-4">Definition in plain English</h2>
    <div class="max-w-3xl space-y-4 text-[var(--color-fg-muted)] leading-relaxed">
      <p>
        <strong class="text-[var(--color-fg)]">Claude Managed Agents</strong> (sometimes
        searched as Anthropic Managed Agents) is a service on the Claude
        Developer Platform that runs AI agents for you. Instead of writing
        and operating the loop that calls Claude, executes tools, stores
        progress, and recovers from failures, you describe the agent and
        Anthropic runs it on its infrastructure.
      </p>
      <p>
        Your application creates a session, sends a task, and listens to an
        event stream while Claude works — reading files, running commands in
        a sandbox, calling MCP tools, and reporting back. The work can run
        for minutes or hours, and you can come back to the same session
        later.
      </p>
      <p>
        Anthropic's <a href={`${DOCS}/overview`}>Managed Agents overview</a> is the
        canonical reference; this page is a shorter map plus the limits the
        launch material does not dwell on.
      </p>
    </div>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-surface)]" data-reveal>
    <div class="site-container py-16">
      <h2 class="font-display text-3xl font-bold mb-8">Official building blocks</h2>
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl">
        {buildingBlocks.map((block) => (
          <div>
            <h3 class="font-semibold text-xl mb-2">{block.name}</h3>
            <p class="text-[var(--color-fg-muted)] leading-relaxed">
              {block.body} <a href={block.href}>{block.name} docs</a>
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="site-container py-16" data-reveal>
    <h2 class="font-display text-3xl font-bold mb-4">Claude Managed Agents vs Claude Agent SDK</h2>
    <h3 class="font-semibold text-xl mb-4">Hosted harness vs in-process SDK</h3>
    <p class="text-[var(--color-fg-muted)] leading-relaxed mb-8 max-w-3xl">
      Both give Claude an agent loop with tools. The difference is where the
      loop runs and who owns everything around it.
    </p>
    <ComparisonTable columns={["", "Claude Managed Agents", "Claude Agent SDK"]} rows={sdkRows} caption="Claude Managed Agents vs Claude Agent SDK" />
    <p class="text-[var(--color-fg-muted)] leading-relaxed mt-6 max-w-3xl">
      Choosing between them, and when to move from one to the other, is
      covered in <a href="/blog/claude-agent-sdk-vs-managed-agents/">Claude Agent SDK vs managed agents</a>.
    </p>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-surface)]" data-reveal>
    <div class="site-container py-16">
      <h2 class="font-display text-3xl font-bold mb-8">Concepts you'll see in docs and research</h2>
      <div class="grid md:grid-cols-3 gap-6 text-sm">
        <div>
          <h3 class="font-semibold text-lg mb-2">Agent harness</h3>
          <p class="text-[var(--color-fg-muted)] leading-relaxed">
            The code that turns a model into an agent: it builds context,
            calls the model, dispatches tool calls, and decides when to
            compact or stop. In CMA, Anthropic writes and runs the harness.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">Long-running sessions</h3>
          <p class="text-[var(--color-fg-muted)] leading-relaxed">
            Sessions outlive a single request. They move between running and
            idle, survive infrastructure failures, and keep their event history,
            so asynchronous work does not depend on one open connection.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-lg mb-2">Decoupling the brain from the hands</h3>
          <p class="text-[var(--color-fg-muted)] leading-relaxed">
            Anthropic's <a href="https://www.anthropic.com/research/managed-agents">engineering write-up</a>
            describes separating the brain (model and harness) from the hands
            (sandboxes and tools) behind stable interfaces, so each can fail,
            scale, or be replaced independently.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="site-container py-16" data-reveal>
    <h2 class="font-display text-3xl font-bold mb-8">Limits and trade-offs</h2>
    <div class="grid md:grid-cols-2 gap-8 max-w-5xl">
      <div>
        <h3 class="font-semibold text-xl mb-2">Claude-only model path</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          Agents run Claude models. That is ideal if Claude is your standard;
          it is a constraint if you route tasks across vendors, need an
          open-weight model for some workloads, or want a fallback provider.
        </p>
      </div>
      <div>
        <h3 class="font-semibold text-xl mb-2">Anthropic-hosted cloud default</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          The harness, session state, and event history live in Anthropic's
          cloud. Self-hosted sandboxes move tool execution to your
          infrastructure, but not the control plane. You also cannot read or
          change the harness itself.
        </p>
      </div>
      <div>
        <h3 class="font-semibold text-xl mb-2">Usage-based runtime cost</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          You pay tokens plus session runtime. For long-running or always-on
          agents the runtime line grows; see
          <a href="/blog/claude-managed-agents-pricing/">Claude Managed Agents pricing</a>.
        </p>
      </div>
      <div>
        <h3 class="font-semibold text-xl mb-2">What it is good at</h3>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          Fast time to production, no runtime to operate, and a harness tuned
          by the people who train the model. For many teams those benefits
          outweigh the limits.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-surface)]" data-reveal>
    <div class="site-container py-16 max-w-4xl">
      <h2 class="font-display text-3xl font-bold mb-4">When to consider open alternatives</h2>
      <p class="text-[var(--color-fg-muted)] leading-relaxed mb-4">
        Consider something else when one of the limits above is a hard
        requirement: you need several model vendors, the control plane must
        run on your infrastructure, or you need to change how the harness
        works. Open managed runtimes such as OpenMA keep the same agents,
        environments, sessions, and events shape while letting you choose the
        model, harness, sandbox, and deployment.
      </p>
      <p class="text-[var(--color-fg-muted)] leading-relaxed">
        Need multi-model or self-hosting? Compare the
        <a href="/claude-managed-agents-alternative/">Claude Managed Agents alternative</a> options,
        or go straight to <a href="/blog/claude-managed-agents-vs-open-managed-agents/">Claude Managed Agents vs OpenMA</a>.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/claude-managed-agents-alternative/" class="site-button site-button-primary">Compare alternatives</a>
        <a href="https://docs.openma.ai/" class="site-button">Run an open runtime</a>
      </div>
    </div>
  </section>

  <FaqSection items={faqItems} />
  <RelatedGuides links={relatedLinks} heading="Keep reading" />
</Base>
