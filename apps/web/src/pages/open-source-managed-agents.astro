---
import Base from "../layouts/Base.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import FaqSection from "../components/FaqSection.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import { articleSchema } from "../lib/seo";

const criteriaRows = [
  ["Agent resource", "Versioned agent definitions: model, prompt, tools, MCP, skills"],
  ["Environment resource", "Declarative sandbox spec: packages, networking"],
  ["Durable sessions", "Long-running, resumable, recover after crashes"],
  ["Event stream", "Append-only event log streamed over SSE"],
  ["Isolated execution", "Tools in a sandbox, not in the API process"],
  ["Vaults", "Credentials kept in a vault and added to outbound requests, so the sandbox does not hold them"],
  ["Self-hostable control plane", "The whole runtime runs on your infrastructure"],
];

const shortlistRows = [
  ["OpenMA", "Yes: Claude Managed Agents-compatible /v1 plus OpenAI Agents API adapter", "Yes: Node/Docker, Fly.io, Vercel (beta), Cloudflare", "Claude, OpenAI, DeepSeek, OpenRouter, custom", "Apache 2.0"],
  ["TrueForge", "Own HTTP API and TypeScript SDK", "Yes: local SQLite, or Postgres + Redis", "OpenAI, Anthropic, Gemini, OpenAI-compatible", "MIT"],
  ["Omnara", "Own REST API", "Yes: Docker Compose with Postgres, Redis, S3", "Any compatible model", "Apache 2.0"],
  ["Claude Managed Agents (reference)", "Defines the shape", "No — self-hosted sandbox only", "Claude", "Proprietary"],
];

const faqItems = [
  {
    question: "What is an open-source managed agent runtime?",
    answer:
      "A runtime that implements the managed-agents shape (agents, environments, sessions, events, sandboxes, and credential isolation) with source you can self-host and change.",
  },
  {
    question: "Which open-source runtime implements the Claude Managed Agents shape?",
    answer:
      "Claude Managed Agents itself is proprietary. OpenMA is an Apache 2.0 runtime that implements the same agents, environments, sessions, and events model and can be self-hosted.",
  },
  {
    question: "Can an open-source managed agent runtime use Claude?",
    answer:
      "Yes. OpenMA runs Claude models with your Anthropic key, alongside other providers configured as Model Cards.",
  },
];

const relatedLinks = [
  { href: "/blog/kimi-hosted-agents-vs-openma/", anchor: "Kimi Hosted Agents vs OpenMA", note: "Product comparison and migration boundaries, including the opt-in Node KHA subset." },
  { href: "/ai-agent-platform/", anchor: "AI agent platform & orchestration", note: "The runtime primitives behind every managed agent platform." },
  { href: "/claude-managed-agents-alternative/", anchor: "Claude Managed Agents alternative", note: "Full decision table across hosted and open options." },
  { href: "/open-source-ai-agents/", anchor: "Open-source AI agents", note: "The wider field: platforms, harnesses, frameworks, coding agents." },
  { href: "/self-hosted-ai-agents/", anchor: "Self-hosted AI agents", note: "Why and how teams run agents on their own infra." },
  { href: "/blog/claude-managed-agents-pricing/", anchor: "Claude Managed Agents pricing", note: "Model the hosted bill before choosing a path." },
];

const schemas = [
  articleSchema({
    headline: "Open-Source Managed Agent Runtimes Compared",
    description:
      "Open-source managed agent runtimes compared by the managed-agents shape: agents, environments, sessions, events, sandboxes, and vaults.",
    url: "https://openma.ai/open-source-managed-agents/",
    datePublished: "2026-11-03",
    dateModified: "2026-11-03",
  }),
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Open-Source Managed Agent Runtimes Compared",
    url: "https://openma.ai/open-source-managed-agents/",
    description:
      "Open-source managed agent runtimes compared by the managed-agents shape: agents, environments, sessions, events, sandboxes, and vaults.",
    about: [
      { "@type": "Thing", name: "Open-source managed agent runtime" },
      { "@type": "Thing", name: "Managed agent runtime comparison" },
      { "@type": "Thing", name: "Open Managed Agents" },
    ],
  },
];
---

<Base
  breadcrumbs={[ { name: "Home", path: "/" }, { name: "Open-Source Managed Agent Runtimes", path: "/open-source-managed-agents/" }, ]}
  ogImage="https://openma.ai/og/open-source-managed-agents.png"
  title="Open-Source Managed Agent Runtimes Compared | OpenMA"
  description="Compare open-source managed agent runtimes by agents, sessions, sandboxes, and vaults you can self-host with any model. See where OpenMA fits in production."
  canonical="/open-source-managed-agents/"
  keywords="open-source managed agent runtime, open source managed agent runtimes, managed agent runtime comparison, self-hosted agent runtime, open source claude managed agents"
  schemas={schemas}
>
  <section class="border-b border-[var(--color-border)]">
    <div class="site-container py-16 md:py-24 max-w-4xl">
      <p class="text-sm font-mono uppercase tracking-wider text-[var(--color-fg-subtle)] mb-4">
        Open-source managed agent runtimes
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight mb-6">
        Open-Source Managed Agent Runtimes Compared
      </h1>
      <p class="text-lg text-[var(--color-fg-muted)] leading-relaxed">
        A managed agent runtime owns agents, sessions, sandboxes, and crash
        recovery behind an API. OpenMA, TrueForge, and Omnara are open-source
        runtimes with that shape, and Claude Managed Agents is the hosted
        reference.
      </p>
    </div>
  </section>

  <section class="site-container py-16" data-reveal>
    <h2 class="font-display text-3xl font-bold mb-4">The managed runtime shape</h2>
    <p class="text-[var(--color-fg-muted)] leading-relaxed max-w-3xl">
      A managed agent runtime is a service with an HTTP API. You create an agent and an environment, open a session, send a
      message, and stream events back while the runtime runs the loop,
      executes tools in a sandbox, persists every step, and recovers from
      failures. Open-sourcing that layer means you can audit how credentials
      and data are handled, run it where your data must live, and change the
      parts that do not fit.
    </p>
    <p class="text-[var(--color-fg-muted)] leading-relaxed mt-4 max-w-3xl">
      For the platform primitives behind these runtimes, see the
      <a href="/ai-agent-platform/">AI agent platform guide</a>. For the hosted
      cost baseline, see <a href="/blog/claude-managed-agents-pricing/">Claude Managed Agents pricing</a>.
    </p>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-surface)]" data-reveal>
    <div class="site-container py-16">
      <h2 class="font-display text-3xl font-bold mb-4">Criteria for the managed-runtime shape</h2>
      <p class="text-[var(--color-fg-muted)] leading-relaxed mb-8 max-w-3xl">
        Use these as a checklist when comparing runtimes. A project missing
        several of them is a framework or harness, which can still be the
        right tool for your use case.
      </p>
      <ComparisonTable columns={["Capability", "What to check"]} rows={criteriaRows} caption="Managed agent runtime checklist" />
    </div>
  </section>

  <section class="site-container py-16" data-reveal>
    <h2 class="font-display text-3xl font-bold mb-4">Open-source managed agent runtimes compared</h2>
    <p class="text-[var(--color-fg-muted)] leading-relaxed mb-8 max-w-3xl">
      Claude Managed Agents is included as the reference shape. Third-party
      details come from each project's repository
      (<a href="https://github.com/truefoundry/trueforge">TrueForge</a>,
      <a href="https://github.com/omnara-ai/omnara">Omnara</a>) as of November 2026.
    </p>
    <ComparisonTable columns={["Runtime", "Managed-agents API", "Self-host control plane", "Models", "License"]} rows={shortlistRows} caption="Open-source managed agent runtimes shortlist" />
    <p class="text-[var(--color-fg-muted)] leading-relaxed mt-6 max-w-3xl">
      For the wider field of frameworks, harnesses, and coding agents, see <a href="/open-source-ai-agents/">open-source AI agents</a>.
    </p>
  </section>

  <section class="border-y border-[var(--color-border)] bg-[var(--color-bg-surface)]" data-reveal>
    <div class="site-container py-16 grid md:grid-cols-2 gap-10 max-w-5xl">
      <div>
        <h2 class="font-display text-2xl font-bold mb-4">Self-host next steps</h2>
        <p class="text-[var(--color-fg-muted)] leading-relaxed mb-4">
          Start OpenMA locally with Docker Compose, then move to a Node
          deployment with PostgreSQL or MySQL, or provision it on Cloudflare.
          The <a href="https://docs.openma.ai/self-host/overview/">self-host overview</a> lists every path, and
          <a href="/self-hosted-ai-agents/">self-hosted AI agents</a> explains the trade-offs.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold mb-4">vs Claude Managed Agents</h2>
        <p class="text-[var(--color-fg-muted)] leading-relaxed">
          If you are choosing between Anthropic's hosted runtime and an open
          one, read the <a href="/claude-managed-agents-alternative/">Claude Managed Agents alternative</a> guide
          and the feature-level <a href="/blog/claude-managed-agents-vs-open-managed-agents/">Claude Managed Agents vs OpenMA</a> comparison.
        </p>
      </div>
    </div>
  </section>

  <FaqSection items={faqItems} />
  <RelatedGuides links={relatedLinks} />
</Base>
